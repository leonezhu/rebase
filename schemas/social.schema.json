{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rebase Social Log 灵兽社交日志（T3 灵兽社交 · v0.16）",
  "description": "world/social_log.yaml 硬边界：bot 独占写，落盘前 jsonschema 自校验。只记流水，不记叙事；同对每日 1 次社交由 workflow 按此文件查重；只保留近 7 日条目。",
  "type": "object",
  "required": ["log"],
  "properties": {
    "log": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "required": ["date", "pair", "relation", "stones", "exp"],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "上海时区日期（YYYY-MM-DD）"
          },
          "pair": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9-]{1,39}$"
            },
            "description": "两只灵兽的 owner，升序排列（去重键：pair+date）"
          },
          "relation": {
            "enum": ["亲和", "萍水", "宿敌"],
            "description": "亲疏关系（五行+性格距离确定性判定）"
          },
          "stones": {
            "type": "integer",
            "minimum": -10,
            "maximum": 30,
            "description": "评论者灵石变动（查表固定值）"
          },
          "exp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50,
            "description": "评论者功力变动（查表固定值）"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
