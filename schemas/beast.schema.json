{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rebase Beast",
  "type": "object",
  "required": [
    "name",
    "owner",
    "element",
    "genes",
    "personality",
    "realm",
    "origin"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "description": "灵兽名（玩家所见，玄幻风格）"
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]{1,39}$",
      "description": "缔约者 GitHub 用户名"
    },
    "element": {
      "enum": [
        "metal",
        "wood",
        "earth",
        "water",
        "fire"
      ],
      "description": "五行：metal金 wood木 earth土 water水 fire火"
    },
    "genes": {
      "type": "object",
      "description": "五维基因 0-100",
      "required": [
        "ling",
        "po",
        "qiao",
        "ren",
        "yun"
      ],
      "additionalProperties": false,
      "properties": {
        "ling": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "灵·法术"
        },
        "po": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "魄·体质"
        },
        "qiao": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "巧·敏捷"
        },
        "ren": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "韧·意志"
        },
        "yun": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "韵·灵性"
        }
      }
    },
    "personality": {
      "type": "object",
      "description": "性格三轴，每轴 -100..100",
      "required": [
        "courage",
        "temper",
        "pride"
      ],
      "additionalProperties": false,
      "properties": {
        "courage": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "勇(+)/怯(-)"
        },
        "temper": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "躁(+)/静(-)"
        },
        "pride": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "傲(+)/谦(-)"
        }
      }
    },
    "realm": {
      "enum": [
        "lianqi",
        "zhuji",
        "jindan",
        "yuanying",
        "huashen",
        "dujie",
        "dacheng"
      ],
      "description": "境界：炼气→筑基→金丹→元婴→化神→渡劫→大乘"
    },
    "stage": {
      "enum": [
        "egg",
        "hatched"
      ],
      "description": "egg=未破壳(属性保密,图鉴渲染蛋卡保留惊喜); hatched=已破壳(属性公开)。新卵默认egg, 问灵五问答完破壳仪式转hatched"
    },
    "origin": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000,
      "description": "降世故事（缔约时的来历经历，biography 起点）"
    },
    "mood": {
      "type": "object",
      "required": [
        "state",
        "updated"
      ],
      "properties": {
        "state": {
          "enum": [
            "昂扬",
            "平静",
            "低落"
          ],
          "description": "心境(生存式): 同梦/胜仗→昂扬(+3%), 败仗/迷路→低落(-3%), 由当日经历涨落"
        },
        "updated": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "心情系统"
    },
    "battle_history": {
      "type": "object",
      "properties": {
        "lose_streak": {
          "type": "integer",
          "minimum": 0,
          "description": "连败计数(败方+1,胜方清零)——败者复起称号依据"
        },
        "win_streak": {
          "type": "integer",
          "minimum": 0,
          "description": "连胜计数(保留扩展位)"
        },
        "loss_count": {
          "type": "integer",
          "minimum": 0,
          "description": "总败场计数(败方累计,胜方不增)——负隅顽抗称号依据"
        }
      },
      "additionalProperties": false,
      "description": "斗法历史(bot独占写入):连败/连胜计数,称号系统依据"
    },
    "titles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "description": "称号(威名): bot达成自动授予, 只增不减——首胜/越级斩/连败翻身/天赋首觉/渡劫一次成/拾遗首献/归隐者(NPC)等"
    },
    "mystery": {
      "type": "string",
      "maxLength": 500,
      "description": "血脉之谜（隐藏身世线索，随境界解锁）"
    },
    "spirit_stones": {
      "type": "integer",
      "minimum": 0,
      "default": 100,
      "description": "灵石余额（初始 100，仅 bot 可改）"
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "功力（仅 bot 可改）"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "spirit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 100,
      "description": "灵性(0-100,满100):每败一场-30,<30闭关当日不应战,每日+20恢复,影响战力±"
    },
    "spirit_recovered_at": {
      "type": "string",
      "format": "date",
      "description": "灵性惰性恢复锚点(bot写入的最后一次恢复日期,判断每日+20是否已发放)"
    },
    "talent": {
      "type": "object",
      "required": [
        "name",
        "desc"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 12,
          "description": "天赋技能名"
        },
        "desc": {
          "type": "string",
          "maxLength": 80,
          "description": "天赋一句话描述(叙事用)"
        },
        "kind": {
          "enum": [
            "burst",
            "shield",
            "drain",
            "counter",
            "control",
            "summon"
          ],
          "description": "机制类型: burst爆发/shield护体/drain吸取/counter反击/control封招(命中则对方该回合力度减半)/summon召旧分支残影协战(+25固定伤)"
        },
        "mastery": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999,
          "default": 0,
          "description": "天赋熟练度(bot独占写入,禁玩家PR改):战斗中天赋每触发一次+1。觉醒等级=mastery映射:0-2Lv0,3-7Lv1,8-14Lv2,15+Lv3;触发率30/35/40/45%,特效随级强化(见battle.yml AWAKEN表)"
        }
      },
      "additionalProperties": false,
      "description": "天赋技能(战斗分镜中概率触发,觉醒等级由熟练度映射)"
    },
    "bloodline": {
      "type": "object",
      "description": "解锁公式：unlocked = min(5, 境界段数(炼气0/筑基1/金丹2/元婴3/化神4/渡劫5/大乘5) + wins//2)",
      "required": [
        "unlocked",
        "wins"
      ],
      "additionalProperties": false,
      "properties": {
        "unlocked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "已解开段数(0-5,仅bot可改)：每段+1.5%战力，最高+7.5%"
        },
        "wins": {
          "type": "integer",
          "minimum": 0,
          "description": "斗法胜场累计(仅bot可改)：每2胜解锁1段"
        }
      }
    },
    "memory_fragments": {
      "type": "object",
      "required": [
        "total",
        "unlocked",
        "fragments"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "const": 5,
          "description": "碎片总数恒5"
        },
        "unlocked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "已解锁段数(与血脉之力加成共用此计数)"
        },
        "fragments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "5段记忆文本,按解锁顺序排列;未解锁段用【封印】占位"
        }
      },
      "additionalProperties": false,
      "description": "记忆碎片系统(T2-1):血脉之谜拆5段,境界节点+特殊事件逐段解锁,集齐触发觉醒剧情"
    }
  },
  "additionalProperties": false
}
