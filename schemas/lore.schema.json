{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rebase 遭遇投稿（共创）",
  "type": "object",
  "required": ["name", "story", "stones", "exp", "weight", "contributor"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 12,
      "description": "遭遇名（2-12字，玄幻风格，如'断剑残鸣'）"
    },
    "story": {
      "type": "string",
      "minLength": 30,
      "maxLength": 300,
      "description": "遭遇故事（30-300字）。可用占位符 {name}=灵兽名 {el}=五行，如'它们'。禁技术术语。"
    },
    "stones": {
      "type": "integer",
      "minimum": -10,
      "maximum": 30,
      "description": "灵石变动 -10 ~ +30"
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50,
      "description": "功力奖励 0 ~ +50"
    },
    "weight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "description": "遭遇权重 1 ~ 30（越大越常见）"
    },
    "contributor": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]{1,39}$",
      "description": "投稿人 GitHub 用户名（必须与 PR 作者一致）"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
